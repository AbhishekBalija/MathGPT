# Copy to .env.local and fill in. Only VITE_* variables reach the browser,
# and anything VITE_* is public (visible in the built JavaScript).
# Never put secrets here.

# Backend API
VITE_API_URL_DEV=http://localhost:3000
VITE_API_URL_PROD=

# Google sign-in (public OAuth client ID, ends in .apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# Optional: Google Analytics measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Optional: Sentry DSN (public by design)
VITE_SENTRY_DSN=
