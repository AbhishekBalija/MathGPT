# Copy to .env and fill in real values. Never commit the real file.

# Server
PORT=3000
NODE_ENV=development
# Optional: comma-separated list that replaces the default allowed frontend origins
# CORS_ORIGINS=http://localhost:5173,https://neomath.vercel.app

# Database: Postgres (local for development, Neon for preview and production)
DATABASE_URL=postgres://localhost:5432/neomath

# Auth: required, the server will not start without them.
# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google sign-in
GOOGLE_CLIENT_ID=
# Optional: same id under the frontend name, used as a fallback
# VITE_GOOGLE_CLIENT_ID=

# AI
GEMINI_MATH_AI_API=
# Optional: Gemini calls allowed per day, shown on the admin Overview (until the Settings screen exists)
AI_DAILY_LIMIT=
OPEN_ROUTER_API_KEY=
USE_MULTI_MODEL=false

# Error alerts (Sentry, backend project). Optional: leave empty to send nothing.
SENTRY_DSN=

# Sign-up robot check (Cloudflare Turnstile secret). Required in production:
# without it every sign-up is refused. Outside production an empty value
# skips the check, so local development works without Cloudflare.
TURNSTILE_SECRET_KEY=

# Email (Resend): required, the server will not start without them.
# For local development without Resend, set EMAIL_TRANSPORT=console to print
# emails (including Verification Codes) to the server log. Refused in production.
# EMAIL_TRANSPORT=console
RESEND_API=
FROM_EMAIL=NeoMath <onboarding@resend.dev>

# Links in emails
APP_URL=http://localhost:5173

# Admin alert emails: "solving is failing / is back". Leave false outside
# production so local runs and previews never email anyone.
ALERT_EMAILS_ENABLED=false
# Lets Vercel's daily cron call /internal/daily-summary. Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -base64 32
CRON_SECRET=


# Tests only: Postgres test database (default postgres://localhost:5432/neomath_test).
# Must point to localhost and the database name must end in _test.
# TEST_DATABASE_URL=
