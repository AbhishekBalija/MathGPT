# Copy to .env and fill in real values. Never commit the real file.

# Server
PORT=3000
NODE_ENV=development
# Optional: comma-separated list that replaces the default allowed frontend origins
# CORS_ORIGINS=http://localhost:5173,https://neomath.vercel.app

# Database: Postgres (local for development, Neon for preview and production)
DATABASE_URL=postgres://localhost:5432/neomath
# MongoDB: still used by features not yet moved to Postgres
MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=MathGPTDB

# Auth: required, the server will not start without them.
# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google sign-in
GOOGLE_CLIENT_ID=

# AI
GEMINI_MATH_AI_API=
OPEN_ROUTER_API_KEY=
USE_MULTI_MODEL=false

# Email (Resend): required, the server will not start without them.
# For local development without Resend, set EMAIL_TRANSPORT=console to print
# emails (including Verification Codes) to the server log. Refused in production.
# EMAIL_TRANSPORT=console
RESEND_API=
FROM_EMAIL=NeoMath <onboarding@resend.dev>

# Links in emails
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_PROD=https://neomath.vercel.app
APP_URL=http://localhost:5173


# Tests only: Postgres test database (default postgres://localhost:5432/neomath_test).
# Must point to localhost and the database name must end in _test.
# TEST_DATABASE_URL=
